function compareAndGetDiff(arr1,arr2)
    local array3 = {}
    
    -- İki array'in aynı boyutta olduğunu varsayarak eşleşen index'leri veya referansları kıyaslıyoruz
    -- Burada mantık olarak aynı tablonun önceki ve sonraki hâlini kıyaslamak istiyoruz.
    for i = 1, math.min(#arr1, #arr2) do
        local tbl1 = arr1[i]
        local tbl2 = arr2[i]
        
        -- Eğer aynı tablo referansındakilerin içeriği değişdiyse
        if tbl1 == tbl2 and not areTablesEqual(tbl1, tbl2) then
            table.insert(array3, tbl1)
        end
    end
    
    return array3
end
function getAllSubTables(tbl,visited,resultList)
    visited = visited or {}
    resultList = resultList or {}
    
    if visited[tbl] then return resultList end
    visited[tbl] = true
    
    -- Önce ana tabloyu ekle
    table.insert(resultList, tbl)
    
    -- İçindeki değerleri tara
    for _, v in pairs(tbl) do
        if type(v) == "table" then
            getAllSubTables(v, visited, resultList)
        end
    end
    
    return resultList
end
