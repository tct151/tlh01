function compareAndGetDiff2(arr1, arr2)
    local array3 = {}
    local lookup = {}
    
    -- 2. array'deki tabloları hızlı arama için kaydedelim
    for _, tbl in ipairs(arr2) do
        lookup[tbl] = true
    end
    
    -- 1. array'de olup 2. array'de olmayanları seçelim
    for _, tbl in ipairs(arr1) do
        if not lookup[tbl] then
            table.insert(array3, tbl)
        end
    end
    
    return array3
end
