function getTablesFromFuncs11()
    local array1 = {}
    -- true parametresi ile sadece fonksiyonları (veya tüm environment nesnelerini) tarıyoruz
    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "function" then
            -- Fonksiyonun içindeki sabitleri (constants) kontrol et
            local success, constants = pcall(debug.getconstants, obj)
            if success and constants then
                for _, constant in pairs(constants) do
                    if type(constant) == "table" then
                        table.insert(array1, constant)
                    end
                end
            end
        end
    end
    return array1
end
