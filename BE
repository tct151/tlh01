function topla()

for _, comb in ipairs(localHoneyCombs:GetChildren()) do
    local handle = comb:FindFirstChild("Handle") or comb.PrimaryPart
    
    if handle then
        -- İsmin sonundaki 4 haneli sayıyı çeker (Örn: Basic_LocalHoneyComb_4536 -> 4536)
        local combId = tonumber(string.match(comb.Name, "%d+"))
        
        if combId then
            local args = {
                [1] = combId,
                [2] = handle.Position
            }
            
            remote:FireServer(unpack(args))
            task.wait(0.01) -- Sunucuya aşırı yüklenip spama düşmemesi için minik bir ara
        end
    end
end

end

