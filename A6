    print("Mevcut Scythe Cooldown:", scv.Scythe.Cooldown)
end

-- 2. Değiştirme (Örn: Cooldown değerini 0.2 yapmak için)
scv.Scythe.Cooldown = 0.2
print("Yeni Scythe Cooldown:", scv.Scythe.Cooldown)

-- Tüm koleksiyoncuları ve cooldown değerlerini listelemek istersen (pairs ile):
for name, data in pairs(scv) do
    if type(data) == "table" and data.Cooldown then
        print(name, "Cooldown:", data.Cooldown)
    end
end



