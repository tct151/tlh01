local scr = game:GetService("ReplicatedStorage").Collectors
local scv = require(scr)

local function searchForScythe(tbl, path)
    for k, v in pairs(tbl) do
        local currentPath = path .. " > " .. tostring(k)
        if k == "Scythe" then
            print("BULundu! Konum:", currentPath)
            print("Scythe Cooldown:", v.Cooldown)
            -- Değiştirmek istersen:
            -- v.Cooldown = 0.2
        elseif type(v) == "table" then
            searchForScythe(v, currentPath)
        end
    end
end

