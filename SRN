function Afk()

	vim=game:GetService("VirtualInputManager")if vim then
    vim:SendKeyEvent(true, Enum.KeyCode.K,false,game) task.wait(0.5)
    vim:SendKeyEvent(false, Enum.KeyCode.K, false, game)
    else game:GetService('VirtualUser'):Button1Down(Vector2.new(0,0)) task.wait(0.5)
    game:GetService('VirtualUser'):Button1Up(Vector2.new(0,0)) end

end	
	



