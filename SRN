function Atak1() HRT=game:GetService("Players").LocalPlayer.Character:WaitForChild("HumanoidRootPart")
	for k,v in pairs(workspace.scps:GetDescendants()) do if v.Name=="HumanoidRootPart" then atesEt1(HRT,v) wait(.2) end end
end
function atesEt1(benimPart, hedefPart)
    -- Hedefin veya boş parçanın konumunu alıp biraz ileri yön ekleyebiliriz
    local pozisyon1 = benimPart.CFrame
    local pozisyon2 = hedefPart.CFrame -- veya hedefPart.CFrame + (hedefPart.CFrame.LookVector * 2)

    local args = {
        [1] = pozisyon1,
        [2] = pozisyon2
    }
    
    game:GetService("ReplicatedStorage").remotes.shoot:FireServer(unpack(args))
end



