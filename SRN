function Silah() for k,v in pairs(game:GetService("ReplicatedStorage").gun_models:GetChildren()) do Silahal(v.Name) end end
function Silahal(s)
	game:GetService("ReplicatedStorage").remotes.Shop:FireServer(s)
	local player = game.Players.LocalPlayer
	local character = player.Character or player.CharacterAdded:Wait()
	local tool = player.Backpack:FindFirstChild(s)
	if tool then tool.Parent = character end
end






















