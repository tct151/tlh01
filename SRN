function Atak3() HRT=game:GetService("Players").LocalPlayer.Character:WaitForChild("HumanoidRootPart")
	for k,v in pairs(workspace.scps:GetDescendants()) do if v.Name=="HumanoidRootPart" then atesEt3(HRT,v) wait(.2) end end
end
function atesEt3(benimPart, bosPart)

    local cf1 = benimPart.CFrame
    local cf2 = bosPart.CFrame
    
    -- [1] = Senin yerinden, bosa doğru bakan CFrame (Açısı bosa çevrildi)
    local yeniCf1 = CFrame.new(cf1.Position, cf2.Position)
    
    local args = {
        [1] = CFrame.new(yeniCf1.Position) * CFrame.Angles(yeniCf1:ToEulerAnglesXYZ()),
        [2] = CFrame.new(cf2.Position) * CFrame.Angles(cf2:ToEulerAnglesXYZ())
    }
    
    game:GetService("ReplicatedStorage").remotes.shoot:FireServer(unpack(args))


end


